{
  "name": "pine-of-glass",
  "version": "0.2.4",
  "description": "Observability extensions for the Pi coding agent",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "context-management",
    "context-window",
    "tool-trace",
    "tool-output",
    "observability",
    "token-accounting"
  ],
  "scripts": {
    "link-pi": "scripts/dev/link-pi-runtime.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/",
    "test:smoke": "node tests/smoke/startup-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-contextimate",
      "./extensions/pi-traceline"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "author": "Thomas Mustier",
  "files": [
    "extensions/pi-contextimate",
    "extensions/pi-traceline",
    "docs",
    "scripts/contextimate",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-contextimate-probe-prefix": "scripts/contextimate/probe-live-prefix.mjs",
    "pi-contextimate-evaluate-transcripts": "scripts/contextimate/evaluate-transcripts.mjs"
  }
}
